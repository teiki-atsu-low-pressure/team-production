# 環境変数のサンプル。
# このファイルをコピーして .env.local という名前で保存し、= の右側に値を入れる。
# .env.local はコミットされない（.gitignore で除外済み）。値をこのファイルに書かないこと。

# Supabase（管理画面の Project Settings で確認する）
# プロジェクトの URL（https://xxxx.supabase.co の形）
SUPABASE_URL=
# Secret key（sb_secret_ で始まる）。DB を制限なしで読み書きできる強い鍵なので、絶対に公開しない
SUPABASE_SECRET_KEY=
